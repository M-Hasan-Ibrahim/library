// Cloudflare configuration for the Library's D1 database and read-only API Worker.
// Used by `npx wrangler@4 d1 ...` (migrations) and `npx wrangler@4 dev` /
// `npx wrangler@4 deploy` (the Worker in worker/). The frontend is deployed
// separately to GitHub Pages and does not read this file.
{
  "name": "library-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",

  // Public address: https://api.library.mh-ibrahim.com (Cloudflare Custom
  // Domain; wrangler creates the DNS record and certificate on deploy).
  "routes": [{ "pattern": "api.library.mh-ibrahim.com", "custom_domain": true }],
  // Single public endpoint: no *.workers.dev or per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Workers Logs: keeps request logs and console.error output (error details
  // are never sent to clients, only logged). Dashboard: Workers > library-api > Logs.
  "observability": { "enabled": true },

  "vars": {
    // Comma-separated origins allowed to read the API from a browser (CORS).
    // Local development adds its own origins with `--var` (see README).
    "ALLOWED_ORIGINS": "https://library.mh-ibrahim.com",

    // Admin sign-in (Cloudflare Access in front of /api/admin/*). Not secrets:
    // the team domain and audience tag are visible in the Access login URL.
    "ACCESS_TEAM_DOMAIN": "mh-ibrahim.cloudflareaccess.com",
    // "Application Audience (AUD) Tag" of the Access application "Library Admin".
    "ACCESS_AUD": "bdcbdda7dec5598bc0ecabcfddf4bd0faaee8d563e2514932a9f65c3b0dacfc8",
    // Where /api/admin/login returns after sign-in (must be in ALLOWED_ORIGINS).
    "SITE_URL": "https://library.mh-ibrahim.com/",
    // This API's public address: uploaded files are served at <it>/files/<key>.
    "PUBLIC_API_URL": "https://api.library.mh-ibrahim.com"
    // ADMIN_EMAIL is a Worker secret (kept out of this public repository):
    // it is uploaded with `npx wrangler@4 deploy --secrets-file <file>`.
    // YOUTUBE_API_KEY (optional) is a Worker secret too: without it, video
    // lookups fall back to YouTube's oEmbed (title and channel only).
  },
  // Uploaded PDFs (Cloudflare R2). The bucket must exist before deploying.
  // It stays private (no public access, no r2.dev address): the Worker serves
  // a file at <PUBLIC_API_URL>/files/<key> only while a published item uses it.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "library-files" }],
  // Hourly at minute 23: removes uploads that nothing uses, a day after their
  // upload (worker/src/files.js cleanupOrphans). Included in Workers Free.
  "triggers": { "crons": ["23 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "library-db",
      // Database ID of library-db (an identifier, not a secret).
      "database_id": "3c3cc55c-21da-4a43-8670-14c6230aa5c2",
      "migrations_dir": "migrations"
    }
  ]
}
